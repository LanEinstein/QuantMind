# U-D1 — Line-2 intraday runtime stores (PIT snapshots + trigger manifests).
data/line2_intraday_snapshots/
data/intraday_manifests/
# Line-1 daily frame SnapshotStore — generated runtime Tushare frames (~40MB);
# never committed (stale frames would shadow fresh fetches). codex P2.
data/line1_frames/
# U-D3/U-D4b — render-only dry-run output (frame store + artifacts); generated
# runtime state, never committed (committing stale frames would make future
# dry-runs reuse them instead of fetching fresh — Codex U-D4b P2).
data/dry_run/
# Phase X — Qwen3-Embedding-0.6B local checkpoint (~600MB, X-006).
# Downloaded via `hf download Qwen/Qwen3-Embedding-0.6B --local-dir
# data/models/Qwen3-Embedding-0.6B` outside of git.
data/models/
# Phase V — slot-rotation runtime ledger (EntryRankStore append-only state
# written by the live service); committing it would seed production-specific
# entry baselines into fresh checkouts — codex P2 2026-06-04.
data/slot_rotation/
# D1-d — take-profit tier ledger (append-only episode state written by the
# live service); never committed (P0-10-amendment-line2-2026-06-04).
data/takeprofit_ledger/
# Line-2 intraday runner durable dedup state (ops hardening 2026-06-04)
data/line2_intraday_state/


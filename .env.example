# === LLM API Keys ===
DEEPSEEK_API_KEY=sk-xxx
QWEN_API_KEY=sk-xxx           # DashScope API Key
MINIMAX_API_KEY=xxx            # MiniMax API Key
# CLAUDE_API_KEY=sk-ant-xxx   # Reserved for future expansion
# OPENAI_API_KEY=sk-xxx       # Reserved for future expansion

# === Database ===
MONGODB_URI=mongodb://mongodb:27017/quantmind
REDIS_URL=redis://redis:6379/0

# === MiroFish ===
ZEP_API_KEY=xxx                # Zep Cloud (MiroFish memory system)

# === Broker ===
BROKER_MODE=mock               # mock / qmt / vnpy
MOCK_INITIAL_CAPITAL=1000000   # Initial mock capital (CNY)

# === System ===
AUTHORIZATION_MODE=suggest     # suggest / confirm / auto
LOG_LEVEL=INFO

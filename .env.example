# =========================================================================
# QuantMind runtime .env template
# =========================================================================
# LLM API keys MUST be stored in shell env vars (~/.bashrc), not here.
# Required exports (see README for details):
#   export DEEPSEEK_API_KEY=sk-...
#   export DASHSCOPE_API_KEY=sk-...   # Qwen via Alibaba DashScope
#   export MOONSHOT_API_KEY=sk-...    # Kimi
# This keeps secrets out of the git tree and survives project re-clones.
#
# Deployment paths:
#   - Local dev (uvicorn): keys resolved from the current shell env directly.
#   - docker-compose up:   compose reads host shell at invocation time and
#                          forwards them into the container via the backend
#                          service's `environment:` block (see docker-compose.yml).
#                          If any required key is missing, compose fails fast
#                          with a clear message instead of silently booting broken.

# === Database ===
MONGODB_URI=mongodb://mongodb:27017/quantmind
REDIS_URL=redis://redis:6379/0

# === MiroFish ===
ZEP_API_KEY=xxx                # Zep Cloud (MiroFish memory system)

# === Broker ===
BROKER_MODE=mock               # mock / qmt / vnpy
MOCK_INITIAL_CAPITAL=1000000   # Initial mock capital (CNY)

# === System ===
# Master-plan phase gate. Backend refuses to start if AUTHORIZATION_MODE
# is not allowed in this phase (P5A-T03 redline). Known phases:
#   phase5_eval    -> {suggest}
#   phase6_prep    -> {suggest}
#   phase6_dryrun  -> {suggest, confirm}
#   phase7_live    -> {suggest, confirm, auto}
QUANTMIND_PHASE=phase5_eval
AUTHORIZATION_MODE=suggest     # suggest / confirm / auto
# Daily LLM cost hard-cap (P5A-T02). Hard ceiling in CNY; soft warning
# fires at ``soft_pct * budget``. Both are read live by cost_guard.
QUANTMIND_DAILY_BUDGET=20.0
QUANTMIND_SOFT_CEIL_PCT=0.7
LOG_LEVEL=INFO

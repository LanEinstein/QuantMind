# QuantMind private LLM env — copy to /home/ps/.config/quantmind/llm.env
# and chmod 600. NEVER commit this file to git.
#
# Installation:
#   mkdir -p /home/ps/.config/quantmind
#   cp deploy/llm.env.example /home/ps/.config/quantmind/llm.env
#   chmod 600 /home/ps/.config/quantmind/llm.env
#   editor /home/ps/.config/quantmind/llm.env
DEEPSEEK_API_KEY=replace-me
DASHSCOPE_API_KEY=replace-me
MOONSHOT_API_KEY=replace-me
